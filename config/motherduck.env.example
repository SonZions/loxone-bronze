# Use a dedicated MotherDuck service/access token for this collector.
MOTHERDUCK_TOKEN=CHANGE_ME
MOTHERDUCK_DATABASE=my_db

SPOOL_DB=/var/lib/loxone-bronze/spool.sqlite3
UPLOAD_BATCH_SIZE=5000
UPLOAD_MAX_BATCHES_PER_RUN=12
# Soft deadline: finish/acknowledge the current batch before stopping.
UPLOAD_MAX_RUNTIME_SECONDS=240
LOCAL_RETENTION_DAYS=7
LOG_LEVEL=INFO

# Used by scripts/healthcheck.sh; backlog can be excluded for deploy checks.
HEALTH_MAX_EVENT_AGE_MINUTES=10
HEALTH_MAX_PENDING_MESSAGES=100000
HEALTH_MAX_PENDING_AGE_MINUTES=30
HEALTH_CHECK_BACKLOG=true
