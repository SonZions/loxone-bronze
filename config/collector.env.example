# Dedicated, low-privilege Loxone visualization user recommended.
LOXONE_URL=http://192.168.1.10
LOXONE_USERNAME=loxone_data
LOXONE_PASSWORD=CHANGE_ME

# Stable logical identifier, useful if a second Miniserver is added later.
LOXONE_SOURCE_ID=home-miniserver

# Used by loxwebsocket to choose the modern authentication path.
# Current Miniserver generations can use 17.0; override if required.
LOXONE_VERSION=17.0

# LoxAPP3 version check; only changed structures are stored.
STRUCTURE_CHECK_SECONDS=300

SPOOL_DB=/var/lib/loxone-bronze/spool.sqlite3
LOG_LEVEL=INFO
