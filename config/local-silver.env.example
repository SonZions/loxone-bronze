# No cloud credentials are loaded by the offline worker.
LOCAL_SILVER_SPOOL=/var/lib/loxone-bronze/spool.sqlite3
LOCAL_SILVER_DATABASE=/srv/raspi-data/loxone-silver/silver.duckdb
LOCAL_SILVER_OUTBOX=/srv/raspi-data/loxone-silver/outbox
LOCAL_SILVER_BATCH_SIZE=100
LOCAL_SILVER_IMPORT_SIZE=250
LOCAL_SILVER_MAX_BATCHES=5
LOCAL_SILVER_MAX_SECONDS=90
LOCAL_SILVER_MEMORY_MB=96
LOCAL_SILVER_MIN_FREE_MB=2048
PUBLISH_DATABASE=my_db
PUBLISH_SCHEMA=loxone_silver_local
PUBLISH_MAX_BATCHES=100
PUBLISH_MAX_SECONDS=180
