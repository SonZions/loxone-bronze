# Merge these values into the existing local.env; preserve paths and checkpoints.
# Use with the Pi 3 service/timer drop-ins after the archive-index migration.
# One fresh process per batch releases native allocations as well as DB buffers.
LOCAL_SILVER_BATCH_SIZE=250
LOCAL_SILVER_IMPORT_SIZE=250
LOCAL_SILVER_MAX_BATCHES=1
LOCAL_SILVER_MAX_SECONDS=30
LOCAL_SILVER_MEMORY_MB=80
# Enable pruning separately after validating both durable retention gates.
LOCAL_SILVER_PRUNE_LOCAL_ONLY=0
