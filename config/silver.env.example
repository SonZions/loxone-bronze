# Separate token: SELECT on loxone_ingest share, WRITE on my_db.
# Do not copy the Bronze service account token without verifying these rights.
MOTHERDUCK_TOKEN=
SILVER_SOURCE_DATABASE=loxone_ingest
SILVER_SOURCE_SCHEMA=loxone_bronze
SILVER_TARGET_DATABASE=my_db
SILVER_TARGET_SCHEMA=loxone_silver
SILVER_BATCH_SIZE=5000
SILVER_MAX_BATCHES=12
SILVER_MAX_RUNTIME_SECONDS=600
