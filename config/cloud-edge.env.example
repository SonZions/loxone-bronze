# Existing MotherDuck credential is loaded separately by the service.
# Point at an immutable installed release. No local Silver code path is reused.
PYTHONPATH=/opt/loxone-cloud-edge/current/app/src
EDGE_SPOOL=/srv/raspi-data/loxone-bronze/spool.sqlite3
EDGE_STATE=/srv/raspi-data/loxone-silver/cloud-edge.sqlite3
EDGE_DATABASE=my_db
EDGE_RAW_SCHEMA=loxone_bronze_edge
EDGE_SILVER_SCHEMA=loxone_silver_local
EDGE_CHUNK_SIZE=5000
EDGE_CHUNK_BYTES=4194304
EDGE_MAX_CHUNKS=5
EDGE_MAX_SECONDS=180
# Once caught up, accumulate useful batches before opening a cloud connection.
EDGE_MIN_MESSAGES=1000
EDGE_MAX_WAIT_SECONDS=300
