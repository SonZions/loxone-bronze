[Unit]
Description=Flight-free Loxone Silver (SSD raw archive, MotherDuck computation)
After=network-online.target
Wants=network-online.target
Conflicts=loxone-local-silver.service loxone-silver-publish.service

[Service]
Type=oneshot
User=loxonebronze
Group=loxonebronze
EnvironmentFile=/etc/loxone-bronze/motherduck.env
EnvironmentFile=/etc/loxone-silver/cloud-edge.env
Environment=PYTHONFAULTHANDLER=1
ExecStartPre=/usr/bin/grep -qw memory /sys/fs/cgroup/cgroup.controllers
ExecStart=/opt/loxone-local-silver/current/venv/bin/python -m loxone_bronze.cloud_edge
TimeoutStartSec=300
TimeoutStopSec=15
CPUQuota=25%
MemoryHigh=220M
MemoryMax=240M
MemorySwapMax=0
Nice=19
UMask=0077
NoNewPrivileges=true
PrivateTmp=true
PrivateDevices=true
ProtectSystem=strict
ProtectHome=true
ProtectKernelTunables=true
ProtectKernelModules=true
ProtectControlGroups=true
# SQLite WAL readers may need to create/write the shared-memory sidecar.
# The application still opens the source database with mode=ro.
ReadWritePaths=/srv/raspi-data/loxone-silver /srv/raspi-data/loxone-bronze
